# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real .env file to Git.

DEBUG=True

# Get this from https://platform.openai.com/api-keys (used starting Phase 15)
OPENAI_API_KEY=your_openai_api_key_here

# Replace YOUR_PASSWORD with the postgres superuser password you set
# during PostgreSQL installation. Database name should match what you
# created in pgAdmin ("papersense").
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/papersense
